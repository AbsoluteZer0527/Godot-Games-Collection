code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 WaterColor : source_color;
uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float FloatParameter = 0.75;
uniform sampler2D tex_frg_5;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = WaterColor;
	float n_out2p4 = n_out2p0.a;


// ColorParameter:6
	vec4 n_out6p0 = ColorParameter;


// FloatParameter:3
	float n_out3p0 = FloatParameter;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, UV);


// Step:4
	float n_out4p0 = step(n_out3p0, n_out5p0.x);


// Mix:7
	vec4 n_out7p0 = mix(n_out2p0, n_out6p0, vec4(n_out4p0));


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out2p4;


}
"
